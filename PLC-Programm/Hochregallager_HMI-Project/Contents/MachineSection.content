      {
        "objectType": "JavaScript",
        "active": true,
        "sourceLines": [
          "TcHmi.Symbol.readEx2('%i%sActorGroupName%/i%', function (data) {",
          "",
          "    if (data.error === TcHmi.Errors.NONE) {",
          "",
          "        var actorGroupName = data.value;",
          "",
          "        var instancePath = `%s%ADS.PLC1.HMI.hmi${actorGroupName}Instances%/s%`;",
          "",
          "        TcHmi.Symbol.readEx2(instancePath, function (data) {",
          "",
          "            if (data.error === TcHmi.Errors.NONE) {",
          "",
          "                var combobox = TcHmi.Controls.get('cbSelectedActorInstance');",
          "",
          "                var plcArray = data.value;",
          "",
          "                var newItems = [];",
          "",
          "                plcArray.forEach(function (wert, index) {",
          "",
          "                    newItems.push({",
          "                        text: wert,",
          "                        value: index + 1",
          "                    });",
          "",
          "                });",
          "",
          "                console.log(newItems);",
          "",
          "                combobox.setSrcData(newItems);",
          "",
          "            } else {",
          "                console.log('Fehler beim Auslesen des Arrays in der PLC:', data.error);",
          "            }",
          "",
          "        });",
          "",
          "    } else {",
          "        console.log('Fehler beim Auslesen der Aktorgruppe im HMI:', data.error);",
          "    }",
          "",
          "});"
        ],
        "asyncWait": true,
        "waitMode": "Synchronous"
      }
    ]
  },
