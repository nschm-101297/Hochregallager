<div id="OperatinmodeButtons" data-tchmi-type="TcHmi.Controls.System.TcHmiUserControlHost" data-tchmi-grid-column-index="1" data-tchmi-grid-row-index="0" data-tchmi-height="100" data-tchmi-height-unit="%" data-tchmi-target-user-control="UserControls/FourButtonSection.usercontrol" data-tchmi-width="100" data-tchmi-width-unit="%" data-tchmi-captionfirstbutton="Manuel" data-tchmi-captionsecondbutton="Automatic" data-tchmi-visibilitythirdbutton="Hidden" data-tchmi-visibilityfourthbutton="Hidden" data-tchmi-variablefirstbutton="%s%ADS.PLC1.HMI.hmiOperatingmodeInterface.HMIToPLC.Manuel.IsSelected|BindingMode=TwoWay|SubscriptionMode=Change%/s%" data-tchmi-variablesecondbutton="%s%ADS.PLC1.HMI.hmiOperatingmodeInterface.HMIToPLC.Automatic.IsSelected|BindingMode=TwoWay|SubscriptionMode=Change%/s%" data-tchmi-isenabledfirstbutton="%s%ADS.PLC1.HMI.hmiOperatingmodeInterface.PLCToHMI.Manuel.PreconditionsFullfilled|BindingMode=TwoWay|SubscriptionMode=Change%/s%" data-tchmi-isenabledsecondbutton="%s%ADS.PLC1.HMI.hmiOperatingmodeInterface.PLCToHMI.Automatic.PreconditionsFullfilled|BindingMode=TwoWay|SubscriptionMode=Change%/s%" data-tchmi-isactivefirstbutton="%s%ADS.PLC1.HMI.hmiOperatingmodeInterface.PLCToHMI.Manuel.IsActive|BindingMode=TwoWay|SubscriptionMode=Change%/s%" data-tchmi-isactivesecondbutton="%s%ADS.PLC1.HMI.hmiOperatingmodeInterface.PLCToHMI.Automatic.IsActive|BindingMode=TwoWay|SubscriptionMode=Change%/s%">
