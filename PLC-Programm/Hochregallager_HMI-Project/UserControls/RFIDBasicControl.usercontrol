  "top": "Solid",
  "bottom": "Solid"
}
</script>

<script data-tchmi-target-attribute="data-tchmi-trigger" type="application/json">[
  {
    "event": "%ctx%owner::Id|EventRegistrationMode=Resolve%/ctx%.onPressed",
    "actions": [
      {
        "objectType": "WriteToSymbol",
        "active": true,
        "symbolExpression": "%i%sRFIDAction%/i%",
        "value": {
          "objectType": "StaticValue",
          "valueType": "tchmi:general#/definitions/String",
          "value": "Read"
        },
        "asyncWait": true
      },
      {
        "objectType": "JavaScript",
        "active": true,
        "sourceLines": [
          "TcHmi.Symbol.readEx2('%pp%PopUpId%/pp%',function(data){",
          "   if(data.error === TcHmi.Errors.NONE){",
          "\tvar popUpId = data.value;",
          "\tvar popUp = TcHmi.Controls.get(popUpId);",
          "\tif(popUp && typeof popUp.open === 'function'){",
          "\t\tpopUp.open();",
          "\t\t}else{",
          "\t\t\tconsole.log('Not able to open popup read!');",
          "\t\t}",
          "}else{",
          "\tconsole.log('PopUpId not readable button read!', data.error);",
          "}                    \t\t                 \t                   \t",
          "                      \t",
          "});"
        ],
        "asyncWait": true,
        "waitMode": "Synchronous"
      }
    ]
  }
]</script>
</div>
