<div id="RFID_1" data-tchmi-type="TcHmi.Controls.System.TcHmiUserControl" data-tchmi-top="0" data-tchmi-left="0" data-tchmi-width="100" data-tchmi-height="100" data-tchmi-width-unit="%" data-tchmi-height-unit="%" data-tchmi-creator-viewport-width="1024" data-tchmi-creator-viewport-height="500" data-tchmi-max-width-unit="px" data-tchmi-min-width-unit="%" data-tchmi-min-height-unit="%" data-tchmi-min-width="100" data-tchmi-min-height="100">

<div id="RFIDMainContainer" data-tchmi-type="TcHmi.Controls.System.TcHmiGrid" data-tchmi-height="100" data-tchmi-height-unit="%" data-tchmi-width="100" data-tchmi-width-unit="%">

<script data-tchmi-target-attribute="data-tchmi-row-options" type="application/json">
[
  {
    "height": 210.0,
    "heightMode": "Value",
    "heightUnit": "px",
    "overflow": false
  },
  {
    "height": 1,
    "heightMode": "Value",
    "heightUnit": "factor"
  }
]
</script>

<script data-tchmi-target-attribute="data-tchmi-cell-options" type="application/json">
[
  {
    "columnIndex": 0,
    "padding": {
      "left": 5,
      "right": 0,
      "top": 5,
      "bottom": 5,
      "leftUnit": "px",
      "rightUnit": "px",
      "topUnit": "px",
      "bottomUnit": "px"
    },
    "rowIndex": 0
  },
  {
    "columnIndex": 0,
    "padding": {
      "left": 5,
      "right": 5,
      "top": 5,
      "bottom": 5,
      "leftUnit": "px",
      "rightUnit": "px",
      "topUnit": "px",
      "bottomUnit": "px"
    },
    "rowIndex": 1
  }
]
</script>
<div id="RFIDBasicFunctionButtons" data-tchmi-type="TcHmi.Controls.System.TcHmiUserControlHost" data-tchmi-height="200" data-tchmi-height-unit="px" data-tchmi-target-user-control="UserControls/RFIDBasicControl.usercontrol" data-tchmi-width="500" data-tchmi-width-unit="px" data-tchmi-textlabel1="Permission Hardware" data-tchmi-textlabel2="Part Present" data-tchmi-popupid="%ctrl%RFIDPopUp::id%/ctrl%" data-tchmi-statusrfid="%s%ADS.PLC1.HMI.hmiMachineSectionInterface.RFID.RFIDStatus%/s%">
</div>
<div id="RFIDPopUp" data-tchmi-type="TcHmi.Controls.System.TcHmiPopup" data-tchmi-height="100" data-tchmi-height-unit="%" data-tchmi-width="100" data-tchmi-width-unit="%" data-tchmi-scrolling="Auto" data-tchmi-header-text="RFID control" data-tchmi-modal="True" data-tchmi-min-height="800">

<script data-tchmi-target-attribute="data-tchmi-target-file" type="application/json">
{
  "path": "UserControls/RFIDPopUpContent.usercontrol",
  "attributes": {
    "data-tchmi-controlinterface": "%s%ADS.PLC1.HMI.hmiMachineSectionInterface.RFID.RFIDControl%/s%",
    "data-tchmi-statusinterface": "%s%ADS.PLC1.HMI.hmiMachineSectionInterface.RFID.RFIDStatus%/s%",
    "data-tchmi-datainterface": "%s%ADS.PLC1.HMI.hmiMachineSectionInterface.RFID.RFIDData%/s%",
    "data-tchmi-popupid": "%ctrl%RFIDPopUp::id%/ctrl%"
  }
}
</script>
</div>
</div>


</div>