<script data-tchmi-target-attribute="data-tchmi-trigger" type="application/json">[
  {
    "event": "%ctx%owner::Id|EventRegistrationMode=Resolve%/ctx%.onPressed",
    "actions": [
      {
        "objectType": "WriteToSymbol",
        "active": true,
        "symbolExpression": "%i%sRFIDAction%/i%",
        "value": {
          "objectType": "StaticValue",
          "valueType": "tchmi:general#/definitions/String",
          "value": "Empty"
        },
        "asyncWait": true
      },
      {
        "objectType": "WriteToSymbol",
        "active": true,
        "symbolExpression": "%i%wSelectedIndex%/i%",
        "value": {
          "objectType": "StaticValue",
          "valueType": "tchmi:general#/definitions/WORD",
          "value": 0
        },
        "asyncWait": true
      },
      {
        "objectType": "WriteToSymbol",
        "active": true,
        "symbolExpression": "%i%wSelectedValue%/i%",
        "value": {
          "objectType": "StaticValue",
          "valueType": "tchmi:general#/definitions/WORD",
          "value": 0
        },
        "asyncWait": true
      },
      {
        "objectType": "JavaScript",
        "active": true,
        "sourceLines": [
          "TcHmi.Symbol.readEx2('%pp%PopUpId%/pp%', function(data){",
          "   if(data.error === TcHmi.Errors.NONE){",
          "\tvar popUpId = data.value;",
          "\tvar popUp = TcHmi.Controls.get(popUpId);",
          "\t",
          "\tif(popUp && typeof popUp.close === 'function'){",
          "\t\tpopUp.close();",
          "\t\t}else{",
          "\t\tconsole.log('Not able to close PopUp!');",
          "\t\t}",
          "",
          "}else{",
          "\tconsole.log('PopUpId not readable: ',data.error);",
          "}                     \t\t",
          "                     \t",
          "});"
        ],
        "asyncWait": true,
        "waitMode": "Synchronous"
      }
    ]
  }
]</script>
</div>
</div>
