															'FeedIn StackerCrane',
															'FeedOut StackerCrane',
															'FeedOut Two meter',
															'FeedOut Curve',
															'FeedOut long'
														 ];
	hmiStackerCraneInstances	:	ARRAY[0..0] OF STRING := [
															'StackerCrane'
														 ];		
	hmiRFIDInstances	:	ARRAY[0..0] OF STRING := [
