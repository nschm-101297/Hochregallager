<UserControl x:Class="WarehouseManagementSystem.Views.UserControls.OrderManagementScreen"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:WarehouseManagementSystem.Views.UserControls"
             mc:Ignorable="d"  
             Background="Beige"
             d:DesignHeight="500" d:DesignWidth="800">
    <UserControl.Resources>
        <Style TargetType="Label">
            <Setter Property="Margin" Value="5"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="HorizontalAlignment" Value="Left"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="FontSize" Value="20"/>
            <Setter Property="FontWeight" Value="Bold"/>
        </Style>
        <Style TargetType="TextBlock">
            <Setter Property="Margin" Value="5"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="FontSize" Value="20"/>
            <Setter Property="FontWeight" Value="Bold"/>
        </Style>
        <Style TargetType="Button">
            <Setter Property="Margin" Value="5"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="MinHeight" Value="40"/>
            <Setter Property="MinWidth" Value="75"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="FontSize" Value="20"/>
            <Setter Property="FontWeight" Value="Bold"/>
        </Style>
        <Style TargetType="RadioButton">
            <Setter Property="Margin" Value="5"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="HorizontalAlignment" Value="Left"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="FontWeight" Value="Bold"/>
        </Style>
        <Style TargetType="GroupBox">
            <Setter Property="Margin" Value="5"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="FontSize" Value="20"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="BorderBrush" Value="Black"/>
            <Setter Property="BorderThickness" Value="2"/>
        </Style>
    </UserControl.Resources>
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <DataGrid Grid.Column="0" Grid.RowSpan="4"
                  Name="dtOrders"
                  CanUserAddRows="False"
                  AutoGenerateColumns="False"
                  ItemsSource="{Binding Orders}">
            <DataGrid.InputBindings>
                <MouseBinding MouseAction="LeftDoubleClick"
                              Command="{Binding OpenEditingView}"
                              CommandParameter="{Binding SelectedItem,
                                                 ElementName=dtOrders,
                                                 Mode=OneWay,
                                                 UpdateSourceTrigger=PropertyChanged}"/>
            </DataGrid.InputBindings>
            <DataGrid.Columns>
                <DataGridTextColumn Header="Typ"
                                    Width="*"
                                    Binding="{Binding TypeOfOrder,
                                                Mode=OneWay,
                                                UpdateSourceTrigger=PropertyChanged}"/>
                <DataGridTextColumn Header="Priority"
                                    Width="*"
                                    Binding="{Binding Priority,
                                                Mode=OneWay,
                                                UpdateSourceTrigger=PropertyChanged}"/>
                <DataGridTextColumn Header="Status"
                                    Width="*"
                                    Binding="{Binding Status,
                                                Mode=OneWay,
                                                UpdateSourceTrigger=PropertyChanged}"/>
                <DataGridTextColumn Header="Date Creation"
                                    Width="*"
                                    Binding="{Binding CreationDate,
                                                Mode=OneWay,
                                                UpdateSourceTrigger=PropertyChanged}"/>
                <DataGridTextColumn Header="Date Done"
                                    Width="*"
                                    Binding="{Binding DoneDate,
                                                Mode=OneWay,
                                                UpdateSourceTrigger=PropertyChanged}"/>
            </DataGrid.Columns>
        </DataGrid>
        <Button Grid.Column="1" Grid.Row="0"
                Command="{Binding AddNewOrder}">
            <Image Source="/Images/add.png" Width="30"/>
        </Button>
        <Button Grid.Column="1" Grid.Row="1"
                Command="{Binding OpenEditingView}">
            <Image Source="/Images/edit.png" Width="30"/>
        </Button>
        <Button Grid.Column="1" Grid.Row="2"
                Command="{Binding DeleteOrder}">
            <Image Source="/Images/delete.png" Width="30"/>
        </Button>
        <StackPanel Grid.Column="2" Grid.RowSpan="4"
                    Orientation="Vertical">
            <GroupBox Header="Filter combination">
                <StackPanel Orientation="Vertical">
                    <RadioButton GroupName="filterCombination"
                                 VerticalContentAlignment="Center"
                                 Content="OR"
                                 IsChecked="{Binding OrConditionActive,
                                             Mode=TwoWay,
                                             UpdateSourceTrigger=PropertyChanged}"/>
                    <RadioButton GroupName="filterCombination"
                                 VerticalContentAlignment="Center"
                                 Content="AND"
                                 IsChecked="{Binding AndConditionActive,
                                             Mode=TwoWay,
                                             UpdateSourceTrigger=PropertyChanged}"/>
                </StackPanel>
            </GroupBox>
            <GroupBox Header="Type">
                <StackPanel Orientation="Vertical">
                    <RadioButton GroupName="type"
                                 VerticalContentAlignment="Center"
                                 Content="Infeed"
                                 IsChecked="{Binding FilterTypeInfeedActive,
                                             Mode=TwoWay,
                                             UpdateSourceTrigger=PropertyChanged}"/>
                    <RadioButton GroupName="type"
                                 VerticalContentAlignment="Center"
                                 Content="Outfeed"
                                 IsChecked="{Binding FilterTypeOutfeedActive,
                                             Mode=TwoWay,
                                             UpdateSourceTrigger=PropertyChanged}"/>
                </StackPanel>
            </GroupBox>
            <GroupBox Header="Priority">
                <StackPanel Orientation="Vertical">
                    <RadioButton GroupName="priority"
                                 VerticalContentAlignment="Center"
                                 Content="Low"
                                 IsChecked="{Binding FilterPriorityLowActive,
                                             Mode=TwoWay,
                                             UpdateSourceTrigger=PropertyChanged}"/>
                    <RadioButton GroupName="priority"
                                 VerticalContentAlignment="Center"
                                 Content="Middle"
                                 IsChecked="{Binding FilterPriorityMiddleActive,
                                             Mode=TwoWay,
                                             UpdateSourceTrigger=PropertyChanged}"/>
                    <RadioButton GroupName="priority"
                                 VerticalContentAlignment="Center"
                                 Content="High"
                                 IsChecked="{Binding FilterPriorityHighActive,
                                             Mode=TwoWay,
                                             UpdateSourceTrigger=PropertyChanged}"/>
                </StackPanel>
            </GroupBox>
            <GroupBox Header="Status">
                <StackPanel Orientation="Vertical">
                    <RadioButton GroupName="status"
                                 VerticalContentAlignment="Center"
                                 Content="Open"
                                 IsChecked="{Binding FilterStatusOpenActive,
                                             Mode=TwoWay,
                                             UpdateSourceTrigger=PropertyChanged}"/>
                    <RadioButton GroupName="status"
                                 VerticalContentAlignment="Center"
                                 Content="In progress"
                                 IsChecked="{Binding FilterStatusInProgressActive,
                                             Mode=TwoWay,
                                             UpdateSourceTrigger=PropertyChanged}"/>
                    <RadioButton GroupName="status"
                                 VerticalContentAlignment="Center"
                                 Content="Done"
                                 IsChecked="{Binding FilterStatusDoneActive,
                                             Mode=TwoWay,
                                             UpdateSourceTrigger=PropertyChanged}"/>
                </StackPanel>
            </GroupBox>
        </StackPanel>
    </Grid>
</UserControl>
