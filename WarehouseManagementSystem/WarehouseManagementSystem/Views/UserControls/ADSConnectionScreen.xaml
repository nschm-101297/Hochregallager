<UserControl x:Class="WarehouseManagementSystem.Views.UserControls.ADSConnectionScreen"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:WarehouseManagementSystem.Views.UserControls"
             xmlns:conv="clr-namespace:WarehouseManagementSystem.Converters"
             mc:Ignorable="d" 
             Background="Beige"
             d:DesignHeight="450" d:DesignWidth="800">
    <UserControl.Resources>
        <Style TargetType="TabItem">
            <Setter Property="FontSize" Value="20"/>
            <Setter Property="FontWeight" Value="Bold"/>
        </Style>
        <Style TargetType="Label">
            <Setter Property="FontSize" Value="20"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Margin" Value="5"/>
        </Style>
        <conv:BoolAsStringToBackgroundConverter x:Key="ConnectionStatus"/>
        <DataTemplate x:Key="BoolTemplate">
            <StackPanel Orientation="Horizontal">
                <Label Content="{Binding Description,
                                 UpdateSourceTrigger=PropertyChanged}"/>
                <Border Margin="5"
                        HorizontalAlignment="Left"
                        MinWidth="50"
                        BorderBrush="Black"
                        BorderThickness="2"
                        Background="{Binding CurrentValue,
                                            UpdateSourceTrigger=PropertyChanged,
                                            Converter={StaticResource ConnectionStatus}}"/>
            </StackPanel>
        </DataTemplate>
        <DataTemplate x:Key="TextTemplate">
            <StackPanel Orientation="Horizontal">
                <Label Content="{Binding Description,
                                 UpdateSourceTrigger=PropertyChanged}"/>
                <Label Margin="5"
                       Content="{Binding CurrentValue,
                                 UpdateSourceTrigger=PropertyChanged}"/>
            </StackPanel>
        </DataTemplate>
        <conv:TemplateSelectorADSConnectionView x:Key="TemplateSelectorADSConnection"
                                                BoolTemplate="{StaticResource BoolTemplate}"
                                                TextTemplate="{StaticResource TextTemplate}"/>
    </UserControl.Resources>
    <Grid>
        <TabControl TabStripPlacement="Left"
                    Background="Transparent"
                    BorderBrush="Black"
                    BorderThickness="1">
            <TabItem Header="General"
                     IsSelected="True">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <Label Grid.Column="0"
                           Grid.Row="0"
                           Content="Connected:"/>
                    <Border Grid.Column="1"
                            Grid.Row="0"
                            Margin="5"
                            HorizontalAlignment="Left"
                            MinWidth="50"
                            BorderBrush="Black"
                            BorderThickness="2"
                            Background="{Binding AdsClientConnection.ClientIsConnected.CurrentValue,
                                                UpdateSourceTrigger=PropertyChanged,
                                                Converter={StaticResource ConnectionStatus}}"/>
                    <Label Grid.Column="0"
                           Grid.Row="1"
                           Content="AMS-NET-ID:"/>
                    <Label Grid.Column="1"
                           Grid.Row="1"
                           Content="{Binding AdsClientConnection.AmsNetID.CurrentValue,
                                     UpdateSourceTrigger=PropertyChanged}"/>
                    <Label Grid.Column="0"
                           Grid.Row="2"
                           Content="ADS-State:"/>
                    <Label Grid.Column="1"
                           Grid.Row="2"
                           Content="{Binding AdsClientConnection.AdsState.CurrentValue,
                                     UpdateSourceTrigger=PropertyChanged}"/>
                </Grid>
            </TabItem>
            <TabItem Header="Detailed"
                     IsSelected="False">
                <ItemsControl Background="Transparent"
                              ItemsSource="{Binding AdsClientConnectionProperties,
                                                    UpdateSourceTrigger=PropertyChanged}"
                              ItemTemplateSelector="{StaticResource TemplateSelectorADSConnection}"/>
            </TabItem>
        </TabControl>   
    </Grid>
</UserControl>
