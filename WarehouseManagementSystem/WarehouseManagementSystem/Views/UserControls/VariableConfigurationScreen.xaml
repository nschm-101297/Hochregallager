<UserControl x:Class="WarehouseManagementSystem.Views.UserControls.VariableConfigurationScreen"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:WarehouseManagementSystem.Views.UserControls"
             xmlns:extk="http://schemas.xceed.com/wpf/xaml/toolkit"
             xmlns:cmd="http://schemas.microsoft.com/xaml/behaviors"
             mc:Ignorable="d"  
             Background="Beige"
             d:DesignHeight="450" d:DesignWidth="800">
    <UserControl.Resources>
        <Style TargetType="ListBox">
            <Setter Property="Margin" Value="5"/>
            <Setter Property="BorderBrush" Value="Black"/>
            <Setter Property="BorderThickness" Value="2"/>
            <Setter Property="AllowDrop" Value="True"/>
        </Style>
        <Style TargetType="Button">
            <Setter Property="Margin" Value="5"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="MinHeight" Value="40"/>
            <Setter Property="MinWidth" Value="75"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="FontSize" Value="20"/>
            <Setter Property="FontWeight" Value="Bold"/>
        </Style>
        <Style TargetType="Label">
            <Setter Property="Margin" Value="5"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="HorizontalAlignment" Value="Left"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="FontSize" Value="20"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="BorderBrush" Value="Black"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>
    </UserControl.Resources>
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <ListBox Grid.Column="0"
                 Name="lbSourceVariables">
            <cmd:Interaction.Triggers>
                <cmd:EventTrigger EventName="DropVariableList">
                    <cmd:InvokeCommandAction
                                  Command="{Binding DropCommandVariableList}"
                                  PassEventArgsToCommand="True"/>
                </cmd:EventTrigger>
            </cmd:Interaction.Triggers>
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <StackPanel Orientation="Vertical">
                        <cmd:Interaction.Triggers>
                            <cmd:EventTrigger EventName="MouseMove">
                                <cmd:InvokeCommandAction
                                              Command="{Binding DataContext.StartChildDragCommand,
                                              RelativeSource={RelativeSource AncestorType=ListBox}}"
                                              PassEventArgsToCommand="True"/>
                            </cmd:EventTrigger>
                        </cmd:Interaction.Triggers>
                        <Image Source="/Images/variable.png" 
                               Width="15"/>
                        <Label Content="{Binding Name}"
                               ToolTip="{Binding Parent}"/>
                    </StackPanel>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
        <StackPanel Grid.Column="1"
            Orientation="Vertical">
            <Button Content="&lt;&lt;"/>
            <Button Content="&lt;"/>
            <Button Content=">"/>
            <Button Content=">>"/>
        </StackPanel>
        <ListBox Grid.Column="2"
                 Name="lbSubscribedVariables">
            <cmd:Interaction.Triggers>
                <cmd:EventTrigger EventName="DropSubscribedList">
                    <cmd:InvokeCommandAction
                                  Command="{Binding DropCommandSubscribedList}"
                                  PassEventArgsToCommand="True"/>
                </cmd:EventTrigger>
            </cmd:Interaction.Triggers>
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <StackPanel Orientation="Vertical">
                        <cmd:Interaction.Triggers>
                            <cmd:EventTrigger EventName="MouseMove">
                                <cmd:InvokeCommandAction
                                              Command="{Binding DataContext.StartChildDragCommand,
                                              RelativeSource={RelativeSource AncestorType=ListBox}}"
                                              PassEventArgsToCommand="True"/>
                            </cmd:EventTrigger>
                        </cmd:Interaction.Triggers>
                        <Image Source="/Images/variable.png" 
                               Width="15"/>
                        <Label Content="{Binding Name}"
                               ToolTip="{Binding Parent}"/>
                    </StackPanel>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
        <extk:PropertyGrid Grid.Column="3"
                           Margin="5"
                           ShowTitle="True"
                           SelectedObject="{Binding SelectedItem}"
                           AutoGenerateProperties="True" />
    </Grid>
</UserControl>
