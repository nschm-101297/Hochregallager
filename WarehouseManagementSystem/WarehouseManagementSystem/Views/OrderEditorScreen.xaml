<Window x:Class="WarehouseManagementSystem.Views.OrderEditorScreen"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:WarehouseManagementSystem.Views"
        xmlns:cv="clr-namespace:WarehouseManagementSystem.Converters"
        mc:Ignorable="d"
        Background="Beige"
        Title="Order Editor" Height="450" Width="500">
    <Window.Resources>
        <cv:StringToOrderTypeConverter x:Key="OrderTypeConverter"/>
        <cv:StringToOrderPriorityConverter x:Key="OrderPriorityConverter"/>
        <cv:StringToOrderStatusConverter x:Key="OrderStatusConverter"/>
        <Style TargetType="Label">
            <Setter Property="Margin" Value="5"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="HorizontalAlignment" Value="Left"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="FontSize" Value="20"/>
            <Setter Property="FontWeight" Value="Bold"/>
        </Style>
        <Style TargetType="TextBlock">
            <Setter Property="Margin" Value="5"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="FontSize" Value="20"/>
            <Setter Property="FontWeight" Value="Bold"/>
        </Style>
        <Style TargetType="ComboBox">
            <Setter Property="Margin" Value="5"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="FontSize" Value="20"/>
            <Setter Property="FontWeight" Value="Bold"/>
        </Style>
        <Style TargetType="Button">
            <Setter Property="Margin" Value="5"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="MinHeight" Value="40"/>
            <Setter Property="MinWidth" Value="75"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="FontSize" Value="20"/>
            <Setter Property="FontWeight" Value="Bold"/>
        </Style>
        <Style TargetType="Image">
            <Setter Property="Stretch" Value="Uniform"/>
            <Setter Property="Width" Value="50"/>
        </Style>
    </Window.Resources>
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition/>
            <RowDefinition/>
            <RowDefinition/>
            <RowDefinition/>
            <RowDefinition/>
        </Grid.RowDefinitions>
        <Label Grid.Column="0" Grid.Row="0"
               Content="Type:"/>
        <ComboBox Grid.Column="1" Grid.Row="0"
                  ItemsSource="{Binding Types}"
                  SelectedItem="{Binding ShownOrder.TypeOfOrder,
                                 Mode=TwoWay,
                                 UpdateSourceTrigger=PropertyChanged,
                                 Converter={StaticResource OrderTypeConverter}}"/>
        <Label Grid.Column="0" Grid.Row="1"
               Content="Priority:"/>
        <ComboBox Grid.Column="1" Grid.Row="1"
                  ItemsSource="{Binding Prioriets}"
                  SelectedItem="{Binding ShownOrder.Priority,
                                 Mode=TwoWay,
                                 UpdateSourceTrigger=PropertyChanged,
                                 Converter={StaticResource OrderPriorityConverter}}"/>
        <Label Grid.Column="0" Grid.Row="2"
               Content="Status:"/>
        <ComboBox Grid.Column="1" Grid.Row="2"
                  ItemsSource="{Binding Statuses}"
                  SelectedItem="{Binding ShownOrder.Status,
                                 Mode=TwoWay,
                                 UpdateSourceTrigger=PropertyChanged,
                                 Converter={StaticResource OrderStatusConverter}}"/>
        <Label Grid.Column="0" Grid.Row="3"
               Content="Type:"/>
        <TextBlock Grid.Column="1" Grid.Row="3"
                   IsEnabled="False"
                   Text="{Binding ShownOrder.CreationDate,
                          Mode=OneWay,
                          UpdateSourceTrigger=PropertyChanged,
                          StringFormat={}{0:dd.MM.yyyy HH:mm}}"/>
        <Button Grid.Column="0" Grid.Row="4"
                Command="{Binding Cancel}">
            <StackPanel Orientation="Horizontal">
                <Image Source="/Images/cancel.png"/>
                <Label Content="Cancel"/>
            </StackPanel>
        </Button>
        <Button Grid.Column="1" Grid.Row="4"
                HorizontalAlignment="Right"
                Command="{Binding Confirm}">
            <StackPanel Orientation="Horizontal">
                <Image Source="/Images/confirm.png"/>
                <Label Content="Confirm"/>
            </StackPanel>
        </Button>
    </Grid>
</Window>
